    "purpose": {
      "status": "documented_static_scope",
      "source": "gdd/ChooseOneSpecialOffer.json#/summary",
      "claim_excerpt": "Choose One Offer bày ba gói ưu đãi cạnh nhau (Package1, Package2, Package3) và mời người chơi 'chọn một' — kèm lựa chọn thứ tư là mua trọn bộ (AllPackages) với mức giảm giá hiển thị 'Buy All {0}% OFF'. Server gửi ba gói theo phân khúc (SegmentedChooseOneOfferPackages) và một gói combo (SegmentedChooseOneCombinedPackage). Kỹ thuật tâm lý ở đây là chuyển câu hỏi từ 'mua hay không' sang 'mua cái nào'"
    },
    "unlock": {
      "status": "described_historical_conditions_runtime_boundary_unverified",
      "source": "gdd/ChooseOneSpecialOffer.json#/unlock",
      "content": "ChooseOneSpecialOfferStateService.CanShowChooseOneSpecialOffer() kết hợp: ChooseOneSpecialOfferConfigModel.IsEnable, level >= FirstLevelToShow (IPlayerService), có ChooseOneSpecialOfferResponse trong cache, chưa mua (IsPurchased == false), còn hạn, và dữ liệu hợp lệ (IsDataWrong() == false). StateService còn giữ AdService — trạng thái quảng cáo tham gia vào quyết định hiển thị (suy luận từ dependency)."
    },
    "entry_flow": {
