{
  "id": "TowerWinStreak",
  "feature": "TowerWinStreak",
  "name": "Tháp chuỗi thắng (Tower)",
  "category": "Event",
  "category_label": "Sự kiện",
  "core_levels_last": false,
  "acceptance_status": "documented_with_explicit_remaining_scope",
  "full_feature_verified": false,
  "checks": {
    "purpose": {
      "status": "documented_static_scope",
      "source": "gdd/TowerWinStreak.json#/summary",
      "claim_excerpt": "Tower Win Streak (trong analytics gọi là 'broom streak' bản v1) là sự kiện chuỗi thắng: mỗi level thắng liên tiếp đưa con mèo/chổi leo lên một bậc của tòa tháp; thua hoặc bỏ level sẽ rơi xuống (TowerActionState.Fall) và chuỗi bị reset về 0. Các mốc chính (main step) 3/6/11/16/22/30/40 trả thưởng dạng rương (CurrencyType.Chest) chứa coin, booster, life vô hạn theo thời gian. Người chơi giữ hai kỷ l"
    },
    "unlock": {
      "status": "described_historical_conditions_runtime_boundary_unverified",
      "source": "gdd/TowerWinStreak.json#/unlock",
      "content": "TowerWinStreakStateService.GetEventState(): trả Disable(7) nếu TowerWinStreakConfigModel.IsEnabled == false; InsufficientLevel(6) nếu level < FirstLevelToShow; NoCachedEvent(0) nếu chưa fetch được sự kiện. Client default: IsEnabled = false, FirstLevelToShow = 50, EventType = 1 (Resources/defaultconfigs/TowerWinStreakConfigModel.json). Ngoài ra IsBroomStreakEnabled() được dùng để tránh chạy song song với sự kiện BroomStreak (bản v2) — nếu BroomStreak bật thì Tower nhường chỗ."
    },
    "entry_flow": {
      "status": "documented_paths_not_all_executed",
      "entry_points": [
        "TowerWinStreakLobbyButton ở lobby (IsLobbyIconVisible)",
        "TowerWinStreakBannerView — banner tháp hiển thị trên lobby (ShouldShowTowerWinStreakBanner)",
        "Icon trong màn chơi khi ShouldShowInLevelIcon = true (ShouldShowInLevelStreakView)",
        "TowerWinStreakPopUp mở tự động khi về lobby / mở app (ShouldOpenAutomaticallyOnLobbyReturn / ShouldOpenAutomaticallyOnSessionStart, trả kèm TowerWinStreakSource)",
        "TowerWinStreakHomeWelcomingCommand — chèn vào chuỗi welcome ở Home (ShouldShowForceHomeWelcoming)",
        "TowerWinStreakAreYouSureContainer — hiện tháp trên popup 'bạn có chắc muốn thoát?' (ShouldShowOnAreYouSure)",
        "TowerWinStreakTryAgainCommand — nút chơi lại sau khi thua (source TryAgain)",
        "TowerWinStreakInfoPopup — nút info"
      ],
      "flow_source": "gdd/TowerWinStreak.json#/flow",
