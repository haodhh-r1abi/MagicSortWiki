{
  "id": "WeeklyTournament",
  "feature": "WeeklyTournament",
  "name": "Giải đấu tuần (Weekly)",
  "category": "Event",
  "category_label": "Sự kiện",
  "core_levels_last": false,
  "acceptance_status": "documented_with_explicit_remaining_scope",
  "full_feature_verified": false,
  "checks": {
    "purpose": {
      "status": "documented_static_scope",
      "source": "gdd/WeeklyTournament.json#/summary",
      "claim_excerpt": "Weekly Tournament là bảng xếp hạng thi đua theo tuần, chạy liên tục và tự động lặp lại. Mỗi lần thắng một level người chơi được +1 điểm (score) vào bảng xếp hạng tuần của mình; bảng gồm cả người thật lẫn bot (WeeklyLeaderBoardPlayer.IsBot). Khi tuần kết thúc, người chơi mở bảng để xem kết quả và nhận thưởng coin theo hạng: hạng 1 = 1000, hạng 2 = 500, hạng 3 = 250 (mặc định client); từ hạng 4 trở "
    },
    "unlock": {
      "status": "described_historical_conditions_runtime_boundary_unverified",
      "source": "gdd/WeeklyTournament.json#/unlock",
      "content": "WeeklyTournamentStateService.IsUnlocked()/IsVisible(): WeeklyTournamentConfigModel.IsTournamentEnable == true && level người chơi >= FirstLevelToShow. Client default: IsTournamentEnable = true, FirstLevelToShow = 40 (Resources/defaultconfigs/WeeklyTournamentConfigModel.json). Nếu chưa đủ level → WeeklyTournamentStateType.InsufficientLevel(3); nếu tắt → Disable(2); nếu chưa có bảng cache → NoCachedTournament(4)."
    },
    "entry_flow": {
      "status": "documented_paths_not_all_executed",
      "entry_points": [
        "Nút Leaderboard / cúp ở lobby (WeeklyTournamentLeaderboardController)",
        "WeeklyNewFeatureAlertView — highlight lần đầu mở khóa (ShouldShowNewFeatureAlertView)",
        "WeeklyTournamentHomeWelcomingCommand — chèn vào chuỗi welcome khi vào Home",
        "Tự mở bảng kết quả khi về lobby (ShouldOpenAutomaticallyOnLobbyReturnOnResult) hoặc khi mở app (ShouldOpenAutomaticallyOnSessionStartOnResult)",
        "WeeklyTournamentInfoPopup — nút info giải thích luật",
        "Local notification WeeklyTournamentEndNotificationSo (Id 1124) khi giải kết thúc"
      ],
      "flow_source": "gdd/WeeklyTournament.json#/flow",
