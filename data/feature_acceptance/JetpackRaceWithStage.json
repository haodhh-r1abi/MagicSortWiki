  "checks": {
    "purpose": {
      "status": "documented_static_scope",
      "source": "gdd/JetpackRaceWithStage.json#/summary",
      "claim_excerpt": "Jetpack Race With Stage là bản 3 chặng của Jetpack Race, dùng bộ endpoint riêng /v1/*-jetpack-* và schema flatbuffer magicsort.schemas.v1.liveops.jet_pack_v2. Người chơi đua với một nhóm (có bot) trên bảng leaderboard riêng (leaderboardID tách khỏi tournamentID); thắng level thì tiến 1 nấc, thua thì mất chuỗi. Mỗi chặng (currentStage 1/2/3) có mốc đích riêng (maxReachableStageScore) và bộ thưởng r"
    },
    "unlock": {
      "status": "described_historical_conditions_runtime_boundary_unverified",
      "source": "gdd/JetpackRaceWithStage.json#/unlock",
      "content": "JetpackRaceWithStageStateService.GetEventState(): Disable(0) nếu IsEnabled == false; ProgressNotEnough(1) nếu level < FirstLevelToShow; NoCache(2); Join(3); InProgress(4); LocalTimeIsUp(5); RemoteTimeIsUp(6); ClaimedLocally(7); LastStageWinLimitReached(8) khi đã đạt trần thắng ở chặng cuối. Client default: IsEnabled=false, EventType=6, MagicLabEventType=19, FirstLevelToShow=80, StreakDisabled=true, LastStageWinLimit=100 (Resources/defaultconfigs/JetpackRaceWithStageConfigModel.json)."
    },
    "entry_flow": {
      "status": "documented_paths_not_all_executed",
      "entry_points": [
        "Nút lobby (IsLobbyIconVisible / IsLobbyIconVisibleAndNotIntroduced)",
