    "purpose": {
      "status": "documented_static_scope",
      "source": "gdd/SpecialOffer.json#/summary",
      "claim_excerpt": "Special Offer là gói ưu đãi giới hạn thời gian, một lần mua, có bộ mặt thay đổi theo chủ đề mùa (Ancient Deal, Coastline Deal, Coinfall Deal, Heavenly Deal, Splashing Deal, Sorcerer's Deal, St Patrick's, Fourth of July, World Cup, Pool Party…). Server chọn chủ đề (SpecialOfferThemeTpye), kiểu popup (PopupType) và gói theo phân khúc người chơi (SegmentedOfferPackage: IAPProductId, RewardModels, IAP"
    },
    "unlock": {
      "status": "described_historical_conditions_runtime_boundary_unverified",
      "source": "gdd/SpecialOffer.json#/unlock",
      "content": "SpecialOfferStateService.CanShowSpecialOffer() kết hợp: SpecialOfferConfigModel.IsEnable, level >= SpecialOfferConfigModel.FirstLevelToShow (IPlayerService), có SpecialOfferResponse trong cache, chưa mua (SpecialOfferSyncableDataModel.IsPurchased == false), còn hạn, dữ liệu hợp lệ (IsDataWrong() == false) và asset bundle của chủ đề đã tải xong (ShouldDownloadAssets / NeedToDownloadAssets). Các trạng thái thiếu điều kiện tương ứng với SpecialOfferState."
    },
    "entry_flow": {
      "status": "documented_paths_not_all_executed",
