    "term": "Daily Bonus Pick Hat Info",
    "translation": {
      "Term": "Daily Bonus Pick Hat Info",
      "TermType": 0,
      "English": "Pick a <color=#FEC700>Magical Hat</color>\nto get your daily reward!",
